{%- assign src = section.settings.collection | default: collections.all -%}
<section class="oi" id="object-index" data-oi aria-labelledby="oi-title">
  <div class="oi__main">
    <header class="oi__head">
      <p class="h-sub reveal">{{ section.settings.kicker }} // {{ src.products_count }} items</p>
      <h2 class="h-display reveal" id="oi-title" data-delay="60">{{ section.settings.heading }}</h2>
    </header>
    <div class="oi__nav" data-oi-nav hidden>
      <button type="button" data-oi-prev aria-label="Previous items">&lt;</button>
      <button type="button" data-oi-next aria-label="Next items">&gt;</button>
    </div>
    <ol class="oi__grid" data-oi-track tabindex="0" aria-label="Products">
      {%- for product in src.products limit: section.settings.limit -%}
        {%- liquid
          assign brand = 'ap'
          for c in product.collections
            if settings.ds_collection != blank and c.handle == settings.ds_collection.handle
              assign brand = 'ds'
            elsif c.handle contains 'deadly'
              assign brand = 'ds'
            endif
          endfor
        -%}
        <li class="oi__item oi__item--{{ brand }}">
          <div class="oi__tag">
            <span class="oi__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="oi__brand">{% if brand == 'ds' %}{{ settings.ds_name | default: 'Deadly Soul' }}{% else %}{{ settings.ap_name | default: 'A/P' }}{% endif %}</span>
          </div>
          {% render 'product-card', product: product %}
        </li>
      {%- endfor -%}
    </ol>
    <a class="btn oi__all" href="{{ section.settings.cta_url | default: '/pages/gallery' }}">{{ section.settings.cta }} &#9654;</a>
  </div>
  <div class="oi__rail" aria-hidden="true">
    <div class="oi__slot" data-hoodie-slot data-hoodie-yaw="-0.5"></div>
  </div>
</section>

{% schema %}
{
  "name": "Object index",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Item select" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The object index" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to list all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "cta", "label": "Button", "default": "Explore full catalogue" },
    { "type": "text", "id": "cta_url", "label": "Button link", "default": "/pages/gallery" }
  ],
  "presets": [{ "name": "Object index" }]
}
{% endschema %}
