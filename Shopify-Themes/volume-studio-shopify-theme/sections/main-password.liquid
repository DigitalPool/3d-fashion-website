<div class="vpass">
  <p class="vpass__mark">VOLUME<span>&reg;</span></p>
  <h1>{{ section.settings.message }}</h1>
  <p class="vpass__names">{{ settings.ap_name | default: 'A/P' }} &times; {{ settings.ds_name | default: 'Deadly Soul' }}</p>
  {%- form 'customer', class: 'vpass__form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}<p class="vpass__note">You're on the list.</p>{%- else -%}
    <div class="field"><input type="email" name="contact[email]" placeholder="Email for early access" required aria-label="Email"><button type="submit">Notify me</button></div>{%- endif -%}
  {%- endform -%}
  <details class="vpass__enter">
    <summary>Enter with password</summary>
    {%- form 'storefront_password', class: 'vpass__form' -%}
      <div class="field"><input type="password" name="password" placeholder="Password" aria-label="Password"><button type="submit">Enter</button></div>
      {%- if form.errors -%}<p class="vpass__note">Wrong password.</p>{%- endif -%}
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Password", "settings": [ { "type": "text", "id": "message", "label": "Message", "default": "The next drop is on its way" } ] }
{% endschema %}
