<div class="page-head"><h1 class="h-display">{{ blog.title }}</h1></div>
<div class="page-body">
  {%- paginate blog.articles by 12 -%}
    <div class="grid">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          <div class="card__media">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}<span class="card__shine"></span></div>
          <div class="card__meta"><h2 class="card__title">{{ article.title }}</h2><span class="h-sub">{{ article.published_at | date: '%b %d' }}</span></div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
