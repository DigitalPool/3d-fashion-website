{%- liquid
  assign img_blocks = section.blocks | where: 'type', 'image'
-%}
<section class="gallery{% unless section.settings.show_heading %} gallery--bare{% endunless %}" data-gallery aria-label="Gallery">
  {%- if section.settings.show_heading -%}
  <header class="gallery__heading">
    <p class="h-sub">{{ section.settings.kicker }}</p>
    <h1 class="h-display">{{ section.settings.heading }}</h1>
  </header>
  {%- endif -%}
  <div class="gallery__grid" data-gallery-grid></div>
  <script type="application/json" data-gallery-json>
    {
      "looks": [
        {%- assign separator = '' -%}
        {%- for block in img_blocks -%}
          {%- if block.settings.image == blank -%}{%- continue -%}{%- endif -%}
          {{ separator }}{
            "src": {{ block.settings.image | image_url: width: 1440 | json }},
            "label": {{ block.settings.caption | default: block.settings.image.alt | default: 'Lookbook image' | json }},
            "url": {{ block.settings.product.url | default: '' | json }}
          }
          {%- assign separator = ',' -%}
        {%- endfor -%}
      ],
      "products": [
        {%- assign src = section.settings.collection | default: collections.all -%}
        {%- for p in src.products limit: 24 -%}
          {% render 'look-json', p: p %}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

<dialog class="lightbox" data-lightbox aria-label="Image viewer">
  <button type="button" class="hud__btn lightbox__close" data-lb-close>Close &times;</button>
  <figure>
    <img alt="">
    <figcaption></figcaption>
    <a class="btn btn--ghost" data-lb-link hidden>Shop this</a>
  </figure>
</dialog>

{% schema %}
{
  "name": "Photo gallery",
  "settings": [
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true, "info": "Turn off when another section above already has the page title." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Archive // lookbook" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gallery" },
    { "type": "collection", "id": "collection", "label": "Fallback collection", "info": "Used when no image blocks are added." }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "caption", "label": "Caption" },
      { "type": "product", "id": "product", "label": "Link to product (optional)" }
    ]}
  ],
  "presets": [{ "name": "Photo gallery" }]
}
{% endschema %}
