<section class="campaign" aria-labelledby="campaign-title">
  <div class="campaign__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.image_alt, sizes: '100vw', widths: '800,1200,1600,2000' }}
    {%- else -%}
      <img src="{{ 'campaign-indigo-stairwell.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1672" height="941" loading="lazy">
    {%- endif -%}
  </div>
  <div class="campaign__copy">
    <div class="campaign__slot" data-hoodie-slot data-hoodie-yaw="0.45" aria-hidden="true"></div>
    <div class="campaign__text">
      <p class="h-sub reveal">{{ section.settings.kicker }}</p>
      <h2 class="h-display reveal" id="campaign-title" data-delay="60">{{ section.settings.heading }}</h2>
      {%- if section.settings.cta != blank -%}
        <a class="btn reveal" data-delay="120" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta }} &#9654;</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaign feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the indigo stairwell campaign image. Keep the left side dark and empty: the 3D hoodie lands there." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Three models in A/P and Deadly Soul streetwear on a concrete stairwell at night" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two brands. One stairwell." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Shop the drop" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Campaign feature" }]
}
{% endschema %}
