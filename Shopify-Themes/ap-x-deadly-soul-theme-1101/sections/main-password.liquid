<div class="boot" style="position:relative;min-height:100vh">
  <div class="boot__inner" style="text-align:center">
    <div class="boot__title"><span class="ap">{{ settings.ap_name | default: 'A/P' }}</span><span class="x">x</span><span class="ds">{{ settings.ds_name | default: 'Deadly Soul' }}</span></div>
    <p class="boot__press" style="animation:blink 1.2s steps(2) infinite">{{ section.settings.message }}</p>
    {%- form 'customer', style: 'max-width:460px;margin:30px auto 0' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p class="boot__hint">YOU'RE ON THE LIST. [OK]</p>{%- else -%}
      <div class="field"><input type="email" name="contact[email]" placeholder="EMAIL FOR EARLY ACCESS" required aria-label="Email"><button type="submit">Notify me</button></div>{%- endif -%}
    {%- endform -%}
    <details style="margin-top:30px;color:#888">
      <summary style="cursor:pointer">Enter with password</summary>
      {%- form 'storefront_password', style: 'max-width:460px;margin:16px auto 0' -%}
        <div class="field"><input type="password" name="password" placeholder="PASSWORD" aria-label="Password"><button type="submit">Enter</button></div>
        {%- if form.errors -%}<p class="boot__hint">Wrong password.</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>
{% schema %}
{ "name": "Password", "settings": [ { "type": "text", "id": "message", "label": "Message", "default": "LOADING NEXT DROP..." } ] }
{% endschema %}
